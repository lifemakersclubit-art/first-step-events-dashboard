# Normalise line endings so local diffs stay minimal and reproducible
# instead of every file showing as fully-changed on Windows.
* text=auto eol=lf

# Lock these explicitly rather than relying on auto-detection.
*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.gs    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.svg   text eol=lf

*.png   binary
*.jpg   binary
*.jpeg  binary
*.ico   binary
*.ttf   binary
*.woff  binary
*.woff2 binary
